{
    "name": "iocod/laravel-permissions",
    "description": "Lightweight permission system for Laravel Applications",
    "type": "library",
    "license": "MIT",
    "authors": [
        {
            "name": "Icod Team"
        }
    ],
    "require": {
        "php": "^8.1",
        "illuminate/support": "^11.0|^12.0",
        "illuminate/database": "^11.0|^12.0",
        "illuminate/cache": "^11.0|^12.0"
    },
    "autoload": {
        "psr-4": {
            "Iocod\\LaravelPermissions\\": "src/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Icod\\LaravelPermissions\\PermissionServiceProvider"
            ],
            "aliases": {
                "Permission": "Icod\\LaravelPermissions\\Facades\\Permission"
            }
        }
    }
}