{
    "name": "iocod/laravel-permissions",
    "description": "Lightweight permission system for Laravel Applications",
    "type": "library",
    "license": "MIT",
    "authors": [
        {
            "name": "Iocod Team"
        }
    ],
    "require": {
        "php": "^8.1",
        "illuminate/support": "^11.0|^12.0"
    },
    "autoload": {
        "psr-4": {
            "Iocod\\LaravelPermissions\\": "src/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Iocod\\LaravelPermissions\\PermissionServiceProvider"
            ],
            "aliases": {
                "Permission": "Iocod\\LaravelPermissions\\Facades\\Permission"
            }
        }
    },
    "require-dev": {
        "orchestra/testbench": "^9.0",
        "phpstan/phpstan": "^2.1",
        "rector/rector": "^2.3",
        "laravel/pint": "^1.27",
        "driftingly/rector-laravel": "^2.1"
    },
    "scripts": {
        "format": "vendor/bin/pint",
        "analyze": "vendor/bin/phpstan analyze",
        "refactor": "vendor/bin/rector process --dry-run"
    }
}